# Copy to .env next to docker-compose.yml. Do not commit the real file.
#
# Coach talks to any OpenAI-compatible chat API. Set COACH_PROVIDER and the
# matching key. Demo containers leave these empty (Coach stays off).

COACH_PROVIDER=xai
COACH_MODEL=grok-4.6

# xai          https://console.x.ai                 XAI_API_KEY     grok-4.6
XAI_API_KEY=

# groq         https://console.groq.com             GROQ_API_KEY    llama-3.3-70b-versatile
GROQ_API_KEY=

# meta         https://ai.developer.meta.com        META_API_KEY    muse-spark-1.3
#              (OpenAI-compatible: https://api.meta.ai/v1)
META_API_KEY=

# openai       https://platform.openai.com          OPENAI_API_KEY  gpt-4.1
OPENAI_API_KEY=

# openai-compatible  any host (OpenRouter, Together, Ollama, …)
# COACH_PROVIDER=openai-compatible
# COACH_BASE_URL=https://openrouter.ai/api/v1
# COACH_API_KEY=
# COACH_MODEL=anthropic/claude-sonnet-4

# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
